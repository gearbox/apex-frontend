{
  "name": "apex-frontend",
  "version": "0.22.4",
  "private": true,
  "type": "module",
  "description": "Apex AI Content Studio — Progressive Web App",
  "scripts": {
    "dev": "vite dev",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy localStorage preferredLanguage baseLocale --emit-ts-declarations",
    "build": "vite build",
    "preview": "vite preview",
    "check": "pnpm paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "gen:api": "openapi-typescript src/lib/api/schema.json -o src/lib/api/types.ts",
    "gen:icons": "npx tsx scripts/generate-icons.ts",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:e2e:chromium": "playwright test --project=desktop-chrome --project=mobile-chrome",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "pnpm test:unit && pnpm test:e2e",
    "test:report": "playwright show-report",
    "test:e2e:webkit": "playwright test --project=mobile-safari",
    "test:pwa": "playwright test tests/e2e/pwa --project=mobile-chrome --project=mobile-safari",
    "format:check": "prettier --check .",
    "verify": "pnpm check && pnpm lint && pnpm format:check && pnpm test:unit && pnpm build",
    "verify:mobile": "pnpm verify && pnpm test:e2e:mobile && pnpm test:pwa",
    "verify:all": "pnpm verify && pnpm test:e2e"
  },
  "keywords": [
    "apex",
    "pwa",
    "sveltekit",
    "ai"
  ],
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=10.32.0 <11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "2.23.0",
    "@playwright/test": "1.57.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/svelte": "^5.4.2",
    "@vite-pwa/sveltekit": "^1.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "sharp": "^0.35.3",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.3.5",
    "vitest": "^4.1.10",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@lucide/svelte": "^1.28.0",
    "@tanstack/svelte-query": "^6.1.38",
    "openapi-fetch": "^0.17.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
